;; Floe Factory — launches tokens with a bonding curve.
;;
;; Anyone sends `create_token` with metadata + curve params; the factory validates
;; them, deploys a Token contract at address(factory, index) and forwards the rest of
;; the TON as the creator's optional first buy.
;;
;; Token addresses depend only on (factory, index), so the mini app enumerates all
;; tokens with get_token_address(0..next_index-1) — no server, no indexer needed.
;; Token code is fixed at deploy of the factory (no set_code): for a new version
;; deploy a new factory, retire the old one and change activeFactory in the app config.
;;
;; storage#_ owner:MsgAddressInt deploy_fee:Coins platform_fee_bps:uint16 next_index:uint64
;;           token_code:^Cell wallet_code:^Cell creation_enabled:1 next_factory:MsgAddress = Storage;

#pragma version >=0.4.4;

#include "imports/stdlib.fc";
#include "imports/constants.fc";
#include "imports/utils.fc";

const FACTORY_MIN_BALANCE = 200000000; ;; 0.2 TON always stays for storage

(slice, int, int, int, cell, cell, int, slice) load_data() inline {
    slice ds = get_data().begin_parse();
    (slice owner, int fee, int bps, int index, cell token_code, cell wallet_code) =
        (ds~load_msg_addr(), ds~load_coins(), ds~load_uint(16), ds~load_uint(64), ds~load_ref(), ds~load_ref());
    int enabled = ds.slice_bits() ? ds~load_uint(1) : 1;
    slice successor = ds.slice_bits() ? ds~load_msg_addr() : begin_cell().store_uint(0, 2).end_cell().begin_parse();
    ds.end_parse();
    return (owner, fee, bps, index, token_code, wallet_code, enabled, successor);
}

() save_data(slice owner, int deploy_fee, int platform_fee_bps, int next_index, cell token_code, cell wallet_code, int enabled, slice successor) impure inline {
    set_data(begin_cell()
        .store_slice(owner)
        .store_coins(deploy_fee)
        .store_uint(platform_fee_bps, 16)
        .store_uint(next_index, 64)
        .store_ref(token_code)
        .store_ref(wallet_code)
        .store_uint(enabled, 1)
        .store_slice(successor)
        .end_cell());
}

() validate_curve(slice curve) impure inline {
    int vt = curve~load_coins();
    int vj = curve~load_coins();
    int max_supply = curve~load_coins();
    int max_buy = curve~load_coins();
    curve.end_parse();
    throw_unless(error::bad_params, (vt >= MIN_VIRTUAL_TON) & (vt <= MAX_VIRTUAL_TON));
    throw_unless(error::bad_params, (max_supply >= MIN_MAX_SUPPLY) & (max_supply <= MAX_MAX_SUPPLY));
    ;; the curve must not reach its asymptote: final price <= ~10 000x start price
    throw_unless(error::bad_params, vj - max_supply >= max_supply / 100);
    throw_unless(error::bad_params, (max_buy == 0) | ((max_buy >= max_supply / 1000) & (max_buy <= max_supply)));
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    int msg_flags = cs~load_msg_flags();
    if (msg_flags & 1) {
        return (); ;; a failed deploy: TON stays on the factory, owner refunds manually
    }
    slice sender = cs~load_msg_addr();
    if (in_msg_body.slice_bits() < 32) {
        return ();
    }
    (int op, int query_id) = in_msg_body~load_op_and_query_id();
    (slice owner, int deploy_fee, int platform_fee_bps, int next_index, cell token_code, cell wallet_code, int enabled, slice successor) = load_data();

    if (op == op::create_token) {
        throw_unless(error::factory_retired, enabled);
        check_same_workchain(sender);
        int creator_fee_bps = in_msg_body~load_uint(16);
        int dev_buy = in_msg_body~load_coins();
        int min_out = in_msg_body~load_coins();
        cell curve = in_msg_body~load_ref();
        cell content = in_msg_body~load_ref();
        in_msg_body.end_parse();

        int required = deploy_fee + DEPLOY_GAS + TOKEN_STORAGE_DEPOSIT;
        if (dev_buy) {
            throw_unless(error::bad_params, dev_buy >= MIN_TRADE);
            required += dev_buy + BUY_GAS;
        }
        throw_unless(error::not_enough_ton, msg_value >= required);
        throw_unless(error::bad_params, creator_fee_bps <= MAX_CREATOR_FEE_BPS);
        validate_curve(curve.begin_parse());
        (int cells, int bits, _, int ok) = compute_data_size?(content, MAX_CONTENT_CELLS);
        throw_unless(error::content_too_big, ok);
        throw_unless(error::content_too_big, bits <= MAX_CONTENT_BITS);

        int index = next_index;
        save_data(owner, deploy_fee, platform_fee_bps, next_index + 1, token_code, wallet_code, enabled, successor);

        cell state_init = calculate_token_state_init(my_address(), index, token_code);
        slice token = calculate_address_by_state_init(state_init);

        raw_reserve(my_balance - msg_value + deploy_fee, RESERVE_REGULAR);

        emit_log(event::token_created, begin_cell()
            .store_uint(event::token_created, 32)
            .store_uint(index, 64)
            .store_slice(token)
            .store_slice(sender)
            .store_uint(now(), 32)
            .end_cell());

        cell body = begin_cell()
            .store_op(op::init_token)
            .store_query_id(query_id)
            .store_slice(sender)
            .store_uint(creator_fee_bps, 16)
            .store_uint(platform_fee_bps, 16)
            .store_coins(dev_buy)
            .store_coins(min_out)
            .store_ref(curve)
            .store_ref(content)
            .store_ref(wallet_code)
            .end_cell();

        send_raw_message(begin_cell()
            .store_msg_flags_and_address_none(BOUNCEABLE)
            .store_slice(token)
            .store_coins(0)
            .store_statinit_ref_and_body_ref(state_init, body)
            .end_cell(), SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
        return ();
    }

    if ((op == op::platform_fee) | (op == op::top_up) | (op == op::excesses)) {
        return (); ;; platform income from tokens
    }

    throw_unless(error::not_owner, equal_slices_bits(sender, owner));

    if (op == op::retire_factory) {
        throw_unless(error::factory_retired, enabled);
        slice next = in_msg_body~load_msg_addr();
        in_msg_body.end_parse();
        check_same_workchain(next);
        throw_unless(error::bad_params, ~ equal_slices_bits(next, my_address()));
        save_data(owner, deploy_fee, platform_fee_bps, next_index, token_code, wallet_code, 0, next);
        raw_reserve(my_balance - msg_value, RESERVE_REGULAR);
        send_simple(sender, 0, begin_cell().store_op(op::excesses).store_query_id(query_id).end_cell(),
            SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_IGNORE_ERRORS);
        return ();
    }

    if (op == op::set_config) {
        int new_deploy_fee = in_msg_body~load_coins();
        int new_fee_bps = in_msg_body~load_uint(16);
        in_msg_body.end_parse();
        throw_unless(error::bad_params, new_fee_bps <= MAX_PLATFORM_FEE_BPS);
        throw_unless(error::bad_params, new_deploy_fee <= 100 * ONE_TON);
        save_data(owner, new_deploy_fee, new_fee_bps, next_index, token_code, wallet_code, enabled, successor);
        return ();
    }

    if (op == op::change_owner) {
        slice new_owner = in_msg_body~load_msg_addr();
        in_msg_body.end_parse();
        check_same_workchain(new_owner);
        save_data(new_owner, deploy_fee, platform_fee_bps, next_index, token_code, wallet_code, enabled, successor);
        return ();
    }

    if (op == op::withdraw) {
        int amount = in_msg_body~load_coins();
        in_msg_body.end_parse();
        int available = my_balance - msg_value - FACTORY_MIN_BALANCE;
        amount = min(amount, available);
        throw_unless(error::balance_error, amount > 0);
        raw_reserve(my_balance - msg_value - amount, RESERVE_REGULAR);
        send_simple(owner, 0, begin_cell().store_uint(0, 32).store_slice("Floe: withdraw").end_cell(),
            SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_IGNORE_ERRORS);
        return ();
    }

    throw(error::wrong_op);
}

(slice, int, int, int, cell, cell, int, slice) get_factory_data() method_id {
    return load_data();
}

slice get_token_address(int index) method_id {
    (_, _, _, _, cell token_code, _, _, _) = load_data();
    return calculate_address_by_state_init(calculate_token_state_init(my_address(), index, token_code));
}
